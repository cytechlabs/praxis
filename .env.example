# Praxis Environment Configuration
# Copy to .env and fill in values: cp .env.example .env
# Generate a strong SECRET_KEY with: openssl rand -hex 32

# =============================================================================
# REQUIRED - App will not start without these
# =============================================================================

# JWT signing key - must be a secure random string (min 32 chars).
# Also used to derive the backend<->broker internal-API shared secret, so the
# backend and agent-broker containers must share the same value. Optionally
# override that derivation with PRAXIS_BROKER_INTERNAL_TOKEN
# (set identically on both containers) for a dedicated rotating token.
SECRET_KEY=

# Admin user password - set to create admin on first run, leave empty to skip
ADMIN_PASSWORD=

# =============================================================================
# DEPLOYMENT MODE
# =============================================================================
# Two modes:
#   1. bundled  (default) - runs Postgres, OpenBao (secrets), and db_backup in-stack
#   2. external           - bring your own Postgres and/or an external
#                           OpenBao/Vault-compatible secrets service
#
# To use bundled (default), keep COMPOSE_PROFILES=bundled below.
# To use external, comment out COMPOSE_PROFILES and set DATABASE_URL
# and/or VAULT_ADDR + VAULT_TOKEN to point at your infrastructure.

COMPOSE_PROFILES=bundled

# =============================================================================
# CONTAINER IMAGES
# =============================================================================
# Prod overlay pulls backend/frontend images from GHCR. Pin a specific
# release by setting PRAXIS_VERSION (e.g. 1.0.0). Defaults to :latest.
#
# PRAXIS_VERSION=1.0.0

# =============================================================================
# OPTIONAL - Defaults shown, override as needed
# =============================================================================

# Environment (development | production). Production-parity is the default; the
# prod overlay (docker-compose.prod.yml) forces ENVIRONMENT=production regardless.
ENVIRONMENT=production

# Admin user settings.
# The bootstrap username maps to a managed Linux login for per-user fleet
# access; ``admin`` commonly collides with an existing host user/group, so the
# default is ``praxisadmin``. (The in-app Administrator role is unaffected.)
ADMIN_USERNAME=praxisadmin
ADMIN_EMAIL=praxisadmin@praxis.dev

# Database
# In bundled mode: these feed the in-stack Postgres.
# In external mode: set DATABASE_URL to your existing Postgres and ignore the
# POSTGRES_* vars (they're only used to build the default URL).
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=praxis
# DATABASE_URL=postgresql://user:pass@your-postgres-host:5432/praxis
# TEST_DATABASE_URL=postgresql://user:pass@your-postgres-host:5432/praxis_test

# Secrets service (bundled OpenBao, or external OpenBao/Vault-compatible).
# VAULT_ADDR / VAULT_TOKEN are kept as the env names for compatibility.
# In bundled mode: VAULT_ADDR auto-resolves to the in-stack `vault` service
# (OpenBao), and the backend auto-loads the token from the shared volume.
# In external mode: set VAULT_ADDR to your OpenBao/Vault-compatible URL and
# provide VAULT_TOKEN. (OpenBao service tokens look like `s.…`, batch `b.…`.)
# VAULT_ADDR=https://openbao.your-company.com:8200
# VAULT_TOKEN=s.xxxxxxxxxxxxxxxxxxxx

# CORS (comma-separated origins). Default is the local Caddy origin; in
# production set this to your real browser origin, e.g. https://praxis.example.com
CORS_ORIGINS=https://localhost,http://frontend:3000

# Trusted hosts (comma-separated)
TRUSTED_HOSTS=localhost,127.0.0.1,backend

# Public origin of the Praxis UI as reached by a browser (Caddy ingress). Used to
# build the OIDC redirect/callback and post-login completion URLs. Default is the
# local Caddy origin; in production set this to your real external URL, e.g.
# https://praxis.example.com
PUBLIC_BASE_URL=https://localhost

# Production backend worker count. Keep this at 1 while interactive SSH session
# runtime is process-local; multiple workers can route WebSocket attachment to a
# worker that did not open the SSH session.
UVICORN_WORKERS=1

# Optional: pin the exact OIDC redirect URI you register with your IdP. When
# unset it is derived as PUBLIC_BASE_URL + /api/backend/auth/oidc/callback.
# OIDC_REDIRECT_URI=https://praxis.example.com/api/backend/auth/oidc/callback

# Public verification key (PEM) for offline license validation. This is a PUBLIC
# key only — never a private/signing key. Release builds ship the production
# verification key; leave unset for a pure free-edition install (no license can
# be validated, so the install stays free). See docs/editions.md.
# PRAXIS_LICENSE_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Root directory local-file audit sinks are confined to. Sink targets are
# relative paths beneath it (e.g. exports/audit.jsonl); absolute paths,
# traversal, and symlinked path components are rejected when the sink is saved
# and again on every delivery. The default is the dedicated backend-only
# audit_sink_data volume, so output survives backend recreation. Change this
# only together with that mount in docker-compose.yml, and never point it at a
# runtime or control directory such as /app, /vault, /etc, /proc, /sys, /dev,
# or /run.
# AUDIT_FILE_SINK_ROOT=/data/praxis/audit-sinks

# Agent-backed file transfers buffer the whole body in backend memory (the SSH
# transport streams instead). The agent path is bounded to this ceiling
# (default 1 GiB), capped at the 5 GiB global transfer limit. Raise only if the
# backend has the RAM headroom for concurrent large agent transfers.
# PRAXIS_AGENT_TRANSFER_MAX_BYTES=1073741824
