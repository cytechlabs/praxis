---
/**
 * Starlight's own search UI, re-exported unchanged.
 *
 * Starlight renders search only when it is generating the index itself or when
 * the Search component has been overridden. The index is generated by
 * `praxis:deterministic-pagefind` instead, so this override is what keeps the
 * search UI in the header. The behaviour is Starlight's; nothing is altered.
 */
import Default from '@astrojs/starlight/components/Search.astro';
---

<Default><slot /></Default>
