---
import Pagination from '@astrojs/starlight/components/Pagination.astro';

// Starlight's default footer links back to a source repository page per
// document. The public site and the bundled copy have different notions of
// "edit this page", so the footer is replaced with a static, mount-independent
// one.
//
// The support link has to resolve from both mount points, so it is built from
// the configured base the same way Starlight's own pathWithBase does: strip any
// trailing slash, then join. That yields "/support" on the public site and
// "/help/support" in the bundled copy. It is inlined rather than imported
// because starlight does not export its utils/ directory.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const supportHref = `${base}/support`;

// Injected by astro.config.mjs from the canonical product version. The
// documentation set describes one release, so there is one value to state.
const PRODUCT_VERSION = __PRAXIS_DOCS_VERSION__;

const PRODUCT_SITE = 'https://praxisfleet.com';
const REPOSITORY = 'https://github.com/cytechlabs/praxis';
---

<Pagination />

<footer class="praxis-docs-footer">
  <p class="praxis-docs-footer-brand">
    <a href={PRODUCT_SITE}>Praxis by Cytech Labs</a>
    <!-- One marker per page, derived from the canonical product version. It
         says which release these pages describe, which matters most in the
         bundled copy, where a reader has no other way to tell whether the
         help they are reading matches the application around it. -->
    <span class="praxis-docs-footer-version" data-praxis-docs-version={PRODUCT_VERSION}>
      Version {PRODUCT_VERSION}
    </span>
  </p>
  <nav class="praxis-docs-footer-links" aria-label="Documentation footer">
    <a href={supportHref}>Support</a>
    <a href={REPOSITORY}>Source repository</a>
  </nav>
  <p class="praxis-docs-footer-note">
    This page is part of a single documentation set that describes the release
    named above. It is published on the web and bundled with the application
    for offline use. Links to praxisfleet.com and GitHub need an internet
    connection.
  </p>
</footer>

<style>
  .praxis-docs-footer {
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--sl-color-gray-5);
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }

  .praxis-docs-footer p {
    margin: 0;
  }

  /* Brand and version sit on one line where there is room and stack below
     roughly 390px, so the marker never pushes the footer wider than the
     column. */
  .praxis-docs-footer-brand {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.625rem;
  }

  .praxis-docs-footer-brand a {
    color: var(--sl-color-white);
    font-weight: 600;
    text-decoration: none;
  }

  /* Deliberately quiet: the version is a fact a reader looks for, not a
     banner. Same dimmest AA-safe gray as the note below. */
  .praxis-docs-footer-version {
    color: var(--sl-color-gray-3);
    font-variant-numeric: tabular-nums;
  }

  .praxis-docs-footer-brand a:hover {
    color: var(--sl-color-accent-high);
  }

  .praxis-docs-footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 1rem;
    margin-top: 0.375rem;
  }

  .praxis-docs-footer-links a {
    color: var(--sl-color-accent-high);
  }

  .praxis-docs-footer-note {
    margin-top: 0.625rem;
    /* Offline readers need to know which of the above leave the machine, and
       one note is quieter than decorating every link with an icon. It stays on
       gray-3, the palette's dimmest WCAG-AA-safe value on this background;
       gray-4 would drop it to roughly 2:1. */
    max-width: 42rem;
  }
</style>
