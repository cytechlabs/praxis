# Backend Environment Configuration
# These values are typically set via docker-compose.yml from the root .env
# This file is for local (non-Docker) development only

# Application
APP_NAME=praxis
ENVIRONMENT=production
DEBUG=false

# Security (REQUIRED - app will not start without these)
SECRET_KEY=change-me-to-a-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/praxis

# Secrets service — bundled OpenBao, or an external OpenBao/Vault-compatible
# service (optional in bundled mode; required when using an external one).
# VAULT_ADDR/VAULT_TOKEN are kept as the env names for compatibility.
# VAULT_ADDR=http://vault:8200
# VAULT_TOKEN=

# CORS and trusted hosts (comma-separated). Default is the local Caddy origin;
# set CORS_ORIGINS to your real browser origin in production.
CORS_ORIGINS=https://localhost,http://frontend:3000
TRUSTED_HOSTS=localhost,127.0.0.1,backend

# Trusted reverse-proxy addresses for forwarded client IPs. Uvicorn
# only rewrites the client IP from X-Forwarded-For / X-Forwarded-Proto when the
# immediate peer is in this list, so rate-limit identity and audit actor IPs
# cannot be spoofed by a direct client. Default (127.0.0.1) trusts only
# loopback; set to your reverse proxy's address(es) — comma-separated — to
# record real client IPs when TLS terminates at a separate proxy such as Caddy.
# Use '*' ONLY when the backend port is never reachable except through a
# trusted proxy.
# FORWARDED_ALLOW_IPS=127.0.0.1

# Audit sinks. Operator-configured HTTP audit sinks reject targets
# that point at loopback/link-local/private/cloud-metadata addresses and require
# https for non-local hosts. Set this to allow an internal, on-network HTTP
# collector (e.g. a private log aggregator). Leave unset in normal deployments.
# AUDIT_SINK_ALLOW_PRIVATE_TARGETS=1

# Root directory local-file audit sinks are confined to. Sink targets are
# relative paths beneath it (e.g. exports/audit.jsonl); absolute paths,
# traversal, and symlinked path components are rejected when the sink is saved
# and again on every delivery. In Docker this is a dedicated backend-only named
# volume; change it only alongside that mount, and never point it at a runtime
# or control directory such as /app, /vault, /etc, /proc, /sys, /dev, or /run.
# AUDIT_FILE_SINK_ROOT=/data/praxis/audit-sinks

# Alert webhooks. Alert webhook destinations reject targets that point at
# loopback/link-local/private/cloud-metadata addresses (same SSRF guard as audit
# sinks, applied at create/update and delivery). This override is independent of
# AUDIT_SINK_ALLOW_PRIVATE_TARGETS above: enabling internal audit sinks does NOT
# open alert targets. Set this only to allow an internal, on-network webhook
# receiver. Leave unset in normal deployments.
# ALERT_ALLOW_PRIVATE_TARGETS=1

# OIDC provider. OIDC discovery, token-exchange, and JWKS requests reject targets
# that point at loopback/link-local/private/cloud-metadata addresses and require
# https by default (same SSRF guard, applied on provider create/update/test and
# again at each runtime request). This override is independent of
# AUDIT_SINK_ALLOW_PRIVATE_TARGETS and ALERT_ALLOW_PRIVATE_TARGETS above: enabling
# either of those does NOT open OIDC targets. Set this only to reach an
# intentional on-network IdP (e.g. a self-hosted Keycloak). Leave unset in normal
# deployments.
# OIDC_ALLOW_PRIVATE_TARGETS=1

# Logging
LOG_LEVEL=DEBUG

# Testing (set to any non-empty value to disable rate limiting in test runs)
# TESTING=true
