# PRA-157 #6: dnf creates .rpmdb/ under $HOME on first run; that's
# /app for the praxis container user. The rpm engine isolates this
# under dnf_state_dir(slug) in production (#6-a), but a developer
# running the integration tests on the host can still see one
# appear in the working tree if HOME isn't pinned.
.rpmdb/

# PRA-134: private praxis-ee wheels dropped into the paid build context are never committed
backend/ee-wheels/*.whl
backend/ee-wheels/*.tar.gz

# PRA-311 upgrade-smoke scratch dir (created under repo because Docker only
# bind-mounts repo paths in this env; cleaned by the script trap)
.tmp-pra311-oldscripts-*

# Astro's generated content types and type-store for the documentation site.
docs-site/.astro/
